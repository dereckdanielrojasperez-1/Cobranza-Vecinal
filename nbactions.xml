<?xml version="1.0" encoding="UTF-8"?>
<actions>
    <action>
        <actionName>run</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>process-classes</goal>
            <goal>org.springframework.boot:spring-boot-maven-plugin:run</goal>
        </goals>
        <properties>
            <spring-boot.run.main-class>com.condominio.AplicacionCobranzaVecinal</spring-boot.run.main-class>
            <spring-boot.run.jvmArguments>-Dspring.profiles.active=external -XX:TieredStopAtLevel=1 -Xverify:none -Dspring.main.lazy-initialization=true -Xms128m -Xmx512m</spring-boot.run.jvmArguments>
        </properties>
    </action>
    <action>
        <actionName>debug</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>process-classes</goal>
            <goal>org.springframework.boot:spring-boot-maven-plugin:run</goal>
        </goals>
        <properties>
            <spring-boot.run.main-class>com.condominio.AplicacionCobranzaVecinal</spring-boot.run.main-class>
            <spring-boot.run.jvmArguments>-Dspring.profiles.active=external -Xdebug -Xrunjdwp:transport=dt_socket,server=n,address=${jpda.address} -XX:TieredStopAtLevel=1</spring-boot.run.jvmArguments>
            <jpda.listen>true</jpda.listen>
        </properties>
    </action>
    <action>
        <actionName>profile</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>process-classes</goal>
            <goal>org.springframework.boot:spring-boot-maven-plugin:run</goal>
        </goals>
        <properties>
            <spring-boot.run.main-class>com.condominio.AplicacionCobranzaVecinal</spring-boot.run.main-class>
            <spring-boot.run.jvmArguments>-Dspring.profiles.active=external -XX:TieredStopAtLevel=1 -Xverify:none -Dspring.main.lazy-initialization=true -Xms128m -Xmx512m</spring-boot.run.jvmArguments>
        </properties>
    </action>
    <action>
        <actionName>rebuild</actionName>
        <packagings>
            <packaging>*</packaging>
        </packagings>
        <goals>
            <goal>clean</goal>
            <goal>compile</goal>
        </goals>
    </action>
    <action>
        <actionName>build</actionName>
        <packagings>
            <packaging>*</packaging>
        </packagings>
        <goals>
            <goal>install</goal>
        </goals>
    </action>
</actions>
